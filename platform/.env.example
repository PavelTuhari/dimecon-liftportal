# Пример конфигурации. Скопируйте в platform/.env и подставьте свои значения.
# Файл .env в репозиторий не попадает — в нём ключ сессий и пароль базы.

# --- база ---
# MySQL (рабочий вариант):
DATABASE_URL=mysql+pymysql://liftportal:ПАРОЛЬ@127.0.0.1:3306/liftportal?charset=utf8mb4
# SQLite (демо-стенд без СУБД):
# DATABASE_URL=sqlite:///data/liftportal.sqlite3

# --- приложение ---
SECRET_KEY=замените-на-случайную-строку
PLATFORM_NAME=LiftPortal
PLATFORM_HOST=localhost:8090
PORT=8090

# --- размещение в подкаталоге чужого домена (демо-хостинг) ---
# URL_PREFIX=TehnCons
# BEHIND_PROXY=1
# SESSION_COOKIE_SECURE=1
# DOCS_DIR=/var/www/eminescu/TehnCons/docs_site

# --- хранилище файлов ---
# UPLOAD_DIR=uploads

# --- почта компании (если не задано, письма копятся в очереди) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=1
# SMTP_FROM=noreply@example.com
